# Copy to .env.local. Both values are public (anon/publishable key only, never service_role).
# Local: printed by `npx supabase status` in the repo root.
# For the emulator use http://10.0.2.2:58321, for a USB phone your PC's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:58321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
